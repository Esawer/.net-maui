<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="_177918.TrainingsPage"
             Title="Treningi"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Style="{StaticResource Navbar}">
            <FlexLayout Direction="Row" JustifyContent="SpaceBetween">
                <Label Text="Historia Treningów" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}" Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
                <ImageButton Source="x.png" Aspect="AspectFit" HorizontalOptions="Center" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" BorderColor="Transparent" Clicked="OnProfileClicked">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource SecondaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                    </ImageButton.Behaviors>
                </ImageButton>
            </FlexLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="8" Spacing="8">

                <Border Style="{StaticResource Card}" Stroke="Transparent" Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="18.10.2026"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                            <Label Text="Trening Pull"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                       Text="45 min"
                       FontSize="12"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryLightText}, Dark={StaticResource SecondaryDarkText}}" />

                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Stroke="Transparent" Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="12.10.2026"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                            <Label Text="Trening Pull"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                       Text="90 min"
                       FontSize="12"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryLightText}, Dark={StaticResource SecondaryDarkText}}" />

                    </Grid>
                </Border>


                <Border Style="{StaticResource Card}" Stroke="Transparent" Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="4.09.2026"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                            <Label Text="Trening Push"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                       Text="450 min"
                       FontSize="12"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryLightText}, Dark={StaticResource SecondaryDarkText}}" />

                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
            

    
    
</ContentPage>