<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="_177918.MainPage"
             Shell.NavBarIsVisible="False">
    

    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0" Style="{StaticResource Navbar}">
            <FlexLayout Direction="Row" JustifyContent="SpaceBetween">
                <Label Text="Dziennik Treningów" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}" Style="{StaticResource SubHeadline}" VerticalOptions="Center">
                    
                </Label> 
                <ImageButton Source="person.png" Aspect="AspectFit" HorizontalOptions="Center" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" BorderColor="Transparent" Clicked="OnProfileClicked">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource SecondaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                    </ImageButton.Behaviors>
                </ImageButton>
            </FlexLayout>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,*">
            <FlexLayout Direction="Row" Grid.Row="0">
                <Border Style="{StaticResource Card}" Stroke="Transparent" Margin="4" Padding="16"  FlexLayout.Grow="1" FlexLayout.Basis="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Image Source="calendar.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource AccentDark}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="18" Style="{StaticResource SubHeadline}" />
                        <Label Text="Treningów w tym Miesiącu" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Stroke="Transparent" Margin="4" Padding="16"  FlexLayout.Grow="1" FlexLayout.Basis="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Image Source="trophy.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource AccentDark}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="Nowy Rekord" Style="{StaticResource SubHeadline}" />
                        <Label Text="Pompki - 15" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>

            <FlexLayout Direction="Row" Grid.Row="1">
                <Border Style="{StaticResource Card}" Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" Margin="4" Padding="16"  FlexLayout.Grow="1" FlexLayout.Basis="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Image Source="like.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="2" Style="{StaticResource SubHeadline}" />
                        <Label Text="Treningi w Tym Tygodniu" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Stroke="Transparent" Margin="4" Padding="16"  FlexLayout.Grow="1" FlexLayout.Basis="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Image Source="fire.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="Dzisiaj" Style="{StaticResource SubHeadline}" />
                        <Label Text="Zrób 30min Cardio" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>
        </Grid>

        <ImageButton Grid.Row="2" Source="plus.png" WidthRequest="72" HeightRequest="72" Padding="12" Margin="16" BorderColor="Transparent" HorizontalOptions="Center" CornerRadius="36" BackgroundColor="{StaticResource AccentLight}">
            <ImageButton.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{StaticResource PrimaryLightText}" />
            </ImageButton.Behaviors>
        </ImageButton>
    </Grid>
    

</ContentPage>
